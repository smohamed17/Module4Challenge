@page
@model IndexModel
@{
    ViewData["Title"] = "Dad Jokes Generator";
}

<div class="container mt-3">

    <h1 class="text-align">Dad Jokes Generator</h1>
    
    <div class="card-body">
        @foreach (string joke in Model.CurrentJoke){
            <h4 class="mb-0 mt-3">Here are the dad jokes: </h4>
            <p class="card-text">@joke</p>
        }

    </div>

    <div class="text-align">
        <form method="post">
            <button type="submit" class="btn btn-secondary">
                More Jokes
            </button>
        </form>
    </div>




</div>